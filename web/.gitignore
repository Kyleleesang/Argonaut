node_modules
dist
.DS_Store
*.local

# Texture / HDRI assets are large and licensed separately — do not commit the
# binaries. Keep public/textures/ and public/hdr/ contents out of git; the
# sources + license notes live in ASSETS.md. Commit only small placeholders if any.
public/textures/*
public/hdr/*
!public/textures/.gitkeep
!public/hdr/.gitkeep

# Local-only texture variants: the 8K originals and the downscaled web set.
# Kept side by side so they can be A/B'd without re-downloading or re-encoding.
public/textures-8k/
public/textures-2k/
